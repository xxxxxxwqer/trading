# ============================================================================
# AI Trading Arena — Environment Variables Template (.env.example)
# ============================================================================
# 1. Copy this file to `.env` in the project root:
#      cp .env.example .env
# 2. Fill in your FREE Alpaca Paper Trading keys and FREE Gemini API key.
# 3. NEVER commit `.env` to Git! (It is already blocked by `.gitignore`.)
# ============================================================================

# --- Alpaca Paper Trading API (FREE — Market Data & Calendar Only) ----------
# Get your keys at: https://app.alpaca.markets/paper/dashboard/overview
# IMPORTANT: Make sure you are on the "Paper Trading" dashboard (keys start with PK...).
# Never use a live trading key or endpoint.
ALPACA_API_KEY=your_alpaca_paper_api_key_here
ALPACA_SECRET_KEY=your_alpaca_paper_secret_key_here

# HARD RULE: Must ALWAYS be https://paper-api.alpaca.markets (never change this)
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# --- Google Gemini API (FREE Tier — Powers Agents 5, 6, 7, 8) ---------------
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_google_ai_studio_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
