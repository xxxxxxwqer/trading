# ============================================================================
# Hard Security Rule: NEVER commit API keys or local environment files
# ============================================================================
.env
.env.*
!.env.example

# Python virtual environments & caches
.venv/
venv/
ENV/
env/
__pycache__/
*.py[cod]
*$py.class
*.so

# Testing & packaging artifacts
.pytest_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/
src/*.egg-info/

# OS & editor files
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/*
!.vscode/settings.json

# Large raw price/EPS research caches stay local; learned patterns, universe fundamentals,
# and parsed filing caches (berkshire_13f_raw.json, congress_ptr_parsed.json) are kept.
data_cache/prices/
data_cache/sec_eps/
data_cache/sec_company_tickers.json

# Note: `state/` and `docs/` are intentionally tracked in Git so GitHub Actions
# can persist agent ledgers and publish the GitHub Pages dashboard each cycle.
